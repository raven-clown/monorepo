{
  "name": "installer",
  "private": true,
  "version": "0.7.0",
  "description": "Custom-branded Windows installer/uninstaller for Snippet Manager",
  "author": "SNOWFLEX",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "prepare-payload": "node scripts/prepare-payload.mjs",
    "build": "npm run prepare-payload && tsc && vite build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "build": {
    "appId": "com.raven.snippetmanager.installer",
    "productName": "Snippet Manager Setup",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "app"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.png",
      "artifactName": "Snippet-Manager-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Snippet-Manager-Setup-${version}.${ext}",
      "unpackDirName": "snippet-manager-setup-runtime"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "raven-clown",
        "repo": "monorepo",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
